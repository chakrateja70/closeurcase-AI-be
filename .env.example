# Credentials for the interactive API docs (/docs, /redoc, /openapi.json)
DOCS_USERNAME=admin
DOCS_PASSWORD=1234

# OpenAI - required for /case_detection/detect
OPENAI_API_KEY=sk-...

# Rate limiting for /case_detection/detect. Required - the app will not start
# without it. slowapi syntax: "10/minute", "5/second", "100/hour".
DETECT_RATE_LIMIT=10/minute

# Optional. "memory://" keeps counters in-process, so the limit is per worker;
# point at a redis:// URL to share one budget across workers and hosts.
RATE_LIMIT_STORAGE=memory://

# Optional. DEBUG additionally logs the model being called per request.
LOG_LEVEL=INFO
