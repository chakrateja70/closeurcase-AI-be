# Credentials for the interactive API docs (/docs, /redoc, /openapi.json)
DOCS_USERNAME=admin
DOCS_PASSWORD=1234

# OpenAI - required. Runs /case_detection/detect, and
# /case_summarization/summarize when called with model=gpt.
OPENAI_API_KEY=sk-...

# Which model /case_summarization/summarize uses when a request does not name
# one: gpt or gemini. Optional - defaults to gpt. An unrecognised value stops
# the app at startup rather than silently falling back.
SUMMARY_PROVIDER=gpt

# Gemini - required only when SUMMARY_PROVIDER=gemini, optional otherwise.
# Left unset while running on gpt, the app still starts; the "gemini" option
# then disappears from GET /case_summarization/models and asking for it
# returns a 503 naming what is available instead.
GEMINI_API_KEY=

# Rate limiting for /case_detection/detect. Required - the app will not start
# without it. slowapi syntax: "10/minute", "5/second", "100/hour".
DETECT_RATE_LIMIT=10/minute

# Rate limiting for /case_summarization/summarize. Also required. Keep this
# well below DETECT_RATE_LIMIT: one call uploads a whole document, so it
# costs far more per request.
SUMMARIZE_RATE_LIMIT=3/minute

# Optional. "memory://" keeps counters in-process, so the limit is per worker;
# point at a redis:// URL to share one budget across workers and hosts.
RATE_LIMIT_STORAGE=memory://

# Optional. DEBUG additionally logs the model being called per request.
LOG_LEVEL=INFO
